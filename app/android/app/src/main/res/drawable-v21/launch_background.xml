<?xml version="1.0" encoding="utf-8"?>
<!-- Branded launch splash: void background + centred logo mark.
     Shown by the OS until Flutter draws its first frame (which is the
     matching in-app SplashScreen). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#07070D" />
        </shape>
    </item>
    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="center"
        android:drawable="@drawable/ic_splash_logo" />
</layer-list>
